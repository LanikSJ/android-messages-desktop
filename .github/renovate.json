{
  "extends": ["config:recommended", ":semanticCommitTypeAll(ci)"],
  "semanticCommits": "enabled",
  "commitMessageLowerCase": "auto",
  "prTitleEnabled": true,
  "prBody": "",
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "ci"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "ci"
    }
  ]
}
